{
	"name": "mapsteps/page-builder-framework",
	"description": "Page Builder Framework, a fast and lightweight WordPress theme.",
	"type": "wordpress-theme",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml --exclude=Generic.Files.LineEndings .",
		"fix": "phpcbf --standard=phpcs.xml --exclude=Generic.Files.LineEndings ."
	}
}
