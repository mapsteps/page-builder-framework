{
	"name": "page-builder-framework",
	"description": "Page Builder Framework development tooling",
	"author": "David",
	"license": "GPL-3.0",
	"devDependencies": {
		"@clack/prompts": "^1.2.0",
		"@types/fs-extra": "^11.0.4",
		"@types/jquery": "^3.5.34",
		"@types/jqueryui": "^1.12.24",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.5.2",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@types/select2": "^4.0.63",
		"lightningcss": "^1.32.0",
		"prettier": "^3.8.1",
		"process": "^0.11.10",
		"sass-embedded": "^1.99.0",
		"shx": "^0.4.0",
		"terser": "^5.46.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.4",
		"wordpress__customize-browser": "github:ultrafastwork/wordpress__customize-browser"
	},
	"dependencies": {
		"@wordpress/components": "^32.5.0",
		"@wordpress/core-data": "^7.43.0",
		"@wordpress/data": "^10.43.0",
		"@wordpress/editor": "^14.43.0",
		"@wordpress/element": "^6.43.0",
		"@wordpress/hooks": "^4.43.0",
		"@wordpress/i18n": "^6.16.0",
		"@wordpress/url": "^4.43.0",
		"choices.js": "^11.2.1",
		"colord": "^2.9.3",
		"jquery": "^3.7.1",
		"ky": "^2.0.0",
		"lodash": "^4.18.1",
		"react": "^18.3.1",
		"react-colorful": "^5.6.1",
		"react-dom": "^18.3.1",
		"select2": "4.1.0-rc.0",
		"styled-jsx": "^5.1.7",
		"vanjs-core": "^1.6.0",
		"zx": "^8.8.5"
	},
	"alias": {
		"react": {
			"global": "React"
		},
		"react-dom": {
			"global": "ReactDOM"
		},
		"react/jsx-runtime": {
			"global": "ReactJSXRuntime"
		},
		"jquery": {
			"global": "jQuery"
		},
		"wp": {
			"global": "wp"
		},
		"lodash": {
			"global": "_"
		},
		"@wordpress/editor": {
			"global": "wp.editor"
		},
		"@wordpress/i18n": {
			"global": "wp.i18n"
		},
		"@wordpress/hooks": {
			"global": "wp.hooks"
		},
		"choices.js": {
			"global": "Choices"
		}
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead"
	],
	"scripts": {
		"wpbf": "node wpbf.mjs",
		"build-wp-theme": "node build-scripts/build-wp-theme.mjs",
		"collect-google-fonts": "node Customizer/Controls/Typography/src/collect-google-fonts.mjs",
		"build-asset": "node build-scripts/build-asset.mjs",
		"build-asset:watch": "node build-scripts/build-asset.mjs --watch",
		"build-control": "node build-scripts/build-control.mjs",
		"build-control:watch": "node build-scripts/build-control.mjs --watch",
		"build-controls-bundle": "node build-scripts/build-controls-bundle.mjs",
		"build-all-controls": "node build-scripts/build-all-controls.mjs",
		"build-all-assets": "node build-scripts/build-all-assets.mjs",
		"build-all": "pnpm build-all-controls && pnpm build-all-assets && pnpm build-controls-bundle",
		"build-style": "pnpm build-asset --path=assets/scss/style.scss && shx rm -f css/min/style-min.js css/min/style-min.js.map",
		"build-postmessage": "node build-scripts/build-asset.mjs --path=inc/customizer/js/postmessage.ts",
		"build-customizer": "node build-scripts/build-asset.mjs --path=inc/customizer/js/customizer.ts"
	}
}
